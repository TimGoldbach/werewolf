# Template for instance/.env (production, linked to ./.env so plain `docker compose`
# finds it) and for apps/api/.env (local development).

# ── How the app is reached ────────────────────────────────────────────────────
# Core file plus exactly one overlay from compose/:
#   compose/caddy.yml          own domain, bundled Caddy with automatic TLS (needs DOMAIN)
#   compose/port.yml           publish on a host port (LAN, or a proxy on the same host)
#   compose/proxy-network.yml  join the Docker network of an existing proxy (needs PROXY_NETWORK)
COMPOSE_FILE=docker-compose.yml:compose/port.yml
# compose/caddy.yml: public domain that points at this server
DOMAIN=
# compose/port.yml: interface and port (127.0.0.1 = only reachable from this host)
WEB_BIND=0.0.0.0
WEB_PORT=8080
# compose/proxy-network.yml: name of the proxy's external Docker network
PROXY_NETWORK=
# Secure session cookie; set to false only when the app is served over plain HTTP (LAN)
SECURE_COOKIES=false

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=werewolf
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=werewolf

# ── Auth (shared password gate) ───────────────────────────────────────────────
# Plain-text group password, for local development ONLY. Production uses the
# hash below and leaves this empty.
GATE_PASSWORD=secret
# Optional: bcrypt hash of the password (takes precedence over GATE_PASSWORD).
GATE_PASSWORD_HASH=
# Secret for signing the session JWT (long and random in production).
SESSION_SECRET=dev-only-insecure-secret-change-me
# Session lifetime
SESSION_TTL=30d

# ── Instance ──────────────────────────────────────────────────────────────────
# Language for visitors who have not picked one yet (en or de)
DEFAULT_LOCALE=en
# Time zone the group plays in (IANA name), for dates and the day/night dashboard
TIME_ZONE=UTC
# Optional: imprint/legal notice link in the footer (empty = no link)
IMPRINT_URL=
# Optional: group name shown instead of "Werewolves" (same in every language)
GROUP_NAME=
# Optional: subtitle on the home page (empty = default text)
GROUP_TAGLINE=
# Accent colour: violet (default), blood, moon, forest, amber or silver
ACCENT_COLOR=violet
# A logo goes into instance/branding/ as logo.svg or logo.png (no variable needed)
# Days to keep the nightly backups in instance/backups
BACKUP_RETENTION_DAYS=14
# Container images. Forks set their own registry here.
IMAGE_PREFIX=ghcr.io/timgoldbach/werewolf
IMAGE_TAG=latest

# ── Local development only (apps/api/.env, apps/web/.env.local) ───────────────
DATABASE_URL=postgresql://werewolf:change-me-in-prod@localhost:5432/werewolf?schema=public
API_PORT=3001
# Internal API URL the Next server (BFF) talks to
API_INTERNAL_URL=http://localhost:3001
# Allowed origin(s) for the API (locally the Next dev server)
WEB_ORIGIN=http://localhost:3000
